# ── LLM ──────────────────────────────────────────
# kiro | ollama | anthropic
LLM_PROVIDER=kiro

# Kiro CLI headless mode (Pro / Pro+ / Pro Max / Power plans)
# Optional: leave empty to use your `kiro-cli login` session (needed for enterprise accounts
# where the Kiro web portal / API keys are disabled). A login session takes priority anyway.
KIRO_API_KEY=
# Optional: pin a model id, or use a Kiro custom agent for every role
KIRO_MODEL=
KIRO_AGENT=
# true = require Kiro's local command sandbox for Developer/Tester (exits if unavailable)
KIRO_SANDBOX=false
KIRO_TIMEOUT_MS=1200000

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Context window. Later roles read all earlier artifacts; raise if outputs look cut off (uses more RAM).
OLLAMA_NUM_CTX=16384

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Slack (Socket Mode) ──────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Must match the slash command in your Slack app (rename if another app already uses /crew)
SLACK_COMMAND=/crew-kiro

# Optional: comma-separated Slack member IDs allowed to approve. Empty = anyone in the channel.
APPROVER_USER_IDS=
MAX_REVISIONS=3

# Where named projects (/crew my-app: <idea>) are stored so they can be resumed by name.
# Default: a `kiro-crew-projects` folder next to this repo.
PROJECTS_DIR=
